{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/burgdev/iconpack/blob/main/src/iconpack/schema/pack.schema.json",
  "title": "iconpack pack.json",
  "type": "object",
  "required": ["schema", "name", "version", "spec", "icons"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "inherits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_md": { "type": ["string", "null"] }
      }
    },
    "spec": { "$ref": "#/$defs/spec" },
    "style": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "anti_references": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rules": { "type": "array", "items": { "type": "string" } },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "anchors": { "type": "array", "items": { "type": "string" } },
    "icons": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/icon" }
    }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "required": ["viewBox", "stroke", "allowed_elements"],
      "additionalProperties": false,
      "properties": {
        "viewBox": { "type": "string", "pattern": "^0 0 \\d+(\\.\\d+)? \\d+(\\.\\d+)?$" },
        "live_area": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "padding": { "type": "number", "minimum": 0 } }
        },
        "stroke": {
          "type": "object",
          "required": ["width"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "linecap": { "enum": ["butt", "round", "square"] },
            "linejoin": { "enum": ["miter", "round", "bevel"] }
          }
        },
        "corner_radius": { "type": "number", "minimum": 0 },
        "fill": { "type": "string" },
        "color": { "type": "string" },
        "allowed_elements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z]+$" }
        },
        "precision": { "type": "number", "exclusiveMinimum": 0 },
        "max_nodes": { "type": "integer", "minimum": 1 },
        "min_gap": { "type": "number", "minimum": 0 }
      }
    },
    "icon": {
      "type": "object",
      "required": ["brief", "status"],
      "additionalProperties": false,
      "properties": {
        "brief": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["todo", "drafting", "in_review", "approved", "escalated"] },
        "chosen": {
          "type": "object",
          "required": ["run", "variant"],
          "additionalProperties": false,
          "properties": {
            "run": { "type": "string" },
            "variant": { "type": "string" }
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "text"],
            "additionalProperties": false,
            "properties": {
              "round": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "rejected_ideas": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
