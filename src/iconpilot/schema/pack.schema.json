{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iconpilot pack.json v2",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "icons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "enum": [
            "user",
            "designer"
          ]
        },
        "source": {
          "type": "string",
          "description": "Where an imported baseline came from (PR, repo, URL)."
        }
      }
    },
    "inherits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_md": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "spec": {
      "$ref": "#/$defs/spec"
    },
    "styles": {
      "type": "object",
      "description": "Pack-local style overrides; ids may extend registry styles.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic revision, bumped on every sanctioned write."
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/icon"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pack-level design rules injected into every drafting context."
    },
    "note": {
      "type": "string",
      "description": "Pack-global note: standing instructions for every drafting round."
    },
    "strictness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "0=loose (early exploration), 1=strict (final polish). Scales gate tolerance."
    },
    "recraft": {
      "type": "object",
      "description": "Recraft seeder configuration (created by `iconpilot recraft-style`).",
      "properties": {
        "style_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "style_ids": {
          "type": "object",
          "description": "Per pack-style Recraft style ids (e.g. mono vs color each get their own).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "Candidates per Recraft request (1-6)."
        }
      },
      "additionalProperties": false,
      "description": "Recraft seeder config: style_ids map is written automatically when styles are created; model/n are user defaults.",
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "description": "Durable human-facing docs: what this pack is for. NOT agent feedback."
    },
    "feedback": {
      "type": "array",
      "description": "Live feedback items for the next draft; archived into .runs/<round>/feedback.json by `next`.",
      "items": {
        "$ref": "#/$defs/feedbackItem"
      }
    },
    "waivers": {
      "type": "array",
      "description": "Documented gate exceptions: {check, target (icon#variant or style:<id>), reason, by}.",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        },
        "required": [
          "check",
          "target",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "required": [
        "viewBox",
        "allowed_elements"
      ],
      "additionalProperties": false,
      "properties": {
        "viewBox": {
          "type": "string",
          "pattern": "^0 0 \\d+(\\.\\d+)? \\d+(\\.\\d+)?$"
        },
        "live_area": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "padding": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "stroke": {
          "type": "object",
          "required": [
            "width"
          ],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "linecap": {
              "enum": [
                "butt",
                "round",
                "square"
              ]
            },
            "linejoin": {
              "enum": [
                "miter",
                "round",
                "bevel"
              ]
            }
          }
        },
        "fill": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "allowed_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+$"
          }
        },
        "precision": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "icon": {
      "type": "object",
      "required": [
        "brief",
        "variants"
      ],
      "additionalProperties": false,
      "properties": {
        "brief": {
          "type": "string",
          "description": "What the icon IS: metaphor, key shapes, avoid."
        },
        "prompt": {
          "type": "string",
          "description": "Optional per-icon composition hints."
        },
        "main_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Optional dominant color; feeds color variants and the review page."
        },
        "colors": {
          "type": "array",
          "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
          "maxItems": 10,
          "description": "Per-icon color subset of the style palette — this icon's own colors."
        },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/variant"
          }
        },
        "note": {
          "type": "string",
          "description": "Persistent per-icon note for the agent."
        },
        "description": {
          "type": "string",
          "description": "Durable docs: what this icon depicts. Feedback for the agent goes in 'note'."
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [],
      "oneOf": [
        {
          "$ref": "#/$defs/authored_variant"
        },
        {
          "$ref": "#/$defs/linked_variant"
        }
      ],
      "properties": {
        "postponed": {
          "type": "boolean",
          "description": "Excluded from rounds until explicitly focused or un-postponed."
        }
      }
    },
    "authored_variant": {
      "type": "object",
      "required": [
        "style",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "anchor": {
          "type": "boolean",
          "description": "Family form baseline: its approved SVG enters all sibling prompts."
        },
        "reference": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*#[a-z][a-z0-9-]*$",
          "description": "Additional specific sibling (icon#variant) to visually match."
        },
        "brief": {
          "type": "string",
          "description": "Variant-level brief override."
        },
        "prompt": {
          "type": "string",
          "description": "Variant-level prompt override."
        },
        "chosen": {
          "type": "object",
          "required": [
            "run",
            "variant"
          ],
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            }
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "round",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "round": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "rejected_ideas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request": {
          "type": "object",
          "description": "Transient next-round request produced by decide (more/like/restart).",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "more",
                "like",
                "restart"
              ]
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "from": {
              "type": "string"
            }
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the materialized SVG at last decision; mismatches flag hand-edits."
        },
        "note": {
          "type": "string",
          "description": "Persistent per-variant note for the agent."
        },
        "pinned": {
          "type": "boolean",
          "description": "Pinned: always included as a style reference in every drafting context."
        },
        "postponed": {
          "type": "boolean",
          "description": "Excluded from rounds until explicitly focused or un-postponed."
        }
      }
    },
    "linked_variant": {
      "type": "object",
      "required": [
        "link"
      ],
      "additionalProperties": false,
      "properties": {
        "link": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*#[a-z][a-z0-9-]*$",
          "description": "Alias of another icon's variant: no own file, no own state."
        }
      }
    },
    "status": {
      "enum": [
        "todo",
        "in_review",
        "approved",
        "stale"
      ],
      "description": "stale = dependency changed or the icons/ file was hand-edited after approval."
    },
    "feedbackItem": {
      "type": "object",
      "description": "One feedback comment for the next draft (todo-like).",
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "pack",
            "icon",
            "variant"
          ]
        },
        "icon": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "enum": [
            "user",
            "agent"
          ]
        },
        "round": {
          "type": "string",
          "description": "Round active when written."
        },
        "created": {
          "type": "string",
          "description": "ISO timestamp when the item was written."
        },
        "revived_from": {
          "type": "string",
          "description": "Provenance for revived items: '<round>/<id>' of the archived original."
        }
      },
      "required": [
        "id",
        "scope",
        "text",
        "author",
        "round"
      ],
      "additionalProperties": false
    }
  }
}
